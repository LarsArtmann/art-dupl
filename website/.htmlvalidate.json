{
  "extends": ["html-validate:recommended"],
  "rules": {
    "void-style": "off",
    "element-permitted-content": "off",
    "no-implicit-button-type": "off",
    "text-content": "off",
    "valid-id": "off",
    "attr-quotes": "error",
    "no-trailing-whitespace": "error",
    "require-sri": "off",
    "wcag/h30": "off",
    "wcag/h63": "off",
    "prefer-tbody": "off",
    "no-inline-style": "off"
  }
}
