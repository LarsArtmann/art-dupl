package printer

import "strconv"

script copyCodeScript(elementId string) {
	const code = document.getElementById(elementId).innerText;
	navigator.clipboard.writeText(code).then(() => {
		const btn = event.target;
		const original = btn.innerText;
		btn.innerText = '✓ Copied!';
		setTimeout(() => btn.innerText = original, 2000);
	});
}

script toggleDiffViewScript(groupNum int, mode string) {
	const comparisons = document.querySelectorAll('[id^="diff-compare-' + groupNum + '-"]');
	comparisons.forEach(function(comp) {
		const content = comp.querySelector('.diff-content');
		if (content) {
			if (mode === 'inline') {
				content.classList.add('inline');
			} else {
				content.classList.remove('inline');
			}
		}
	});
	const buttons = document.querySelectorAll('[id^="diff-toggle-' + groupNum + '-"]');
	buttons.forEach(function(btn) {
		btn.classList.remove('active');
		if (btn.dataset.mode === mode) {
			btn.classList.add('active');
		}
	});
	try {
		localStorage.setItem('artdupl-diff-mode', mode);
	} catch (e) {
	}
}

script showDiffScript(index string, groupId int) {
	const comparisons = document.querySelectorAll('[id^="diff-compare-' + groupId + '-"]');
	comparisons.forEach(function(comp) {
		comp.classList.remove('active');
	});
	const selected = document.getElementById('diff-compare-' + groupId + '-' + index);
	if (selected) {
		selected.classList.add('active');
	}
}

script toggleCollapsed() {
	this.parentElement.classList.toggle('collapsed');
}

templ cloneHeader(data CloneGroupView) {
	<div class="clone-header" onclick={ toggleCollapsed() }>
		<h3>Clone Group #{ strconv.Itoa(data.GroupNum) }</h3>
		<div class="badge-group">
			@templ.Raw(data.BadgesHTML)
			<span class="badge">{ strconv.Itoa(data.Occurrences) } occurrences · { strconv.Itoa(data.TotalTokens) } tokens</span>
		</div>
	</div>
}

templ suggestionBlock(data CloneGroupView) {
	if data.Suggestion != "" {
		<div class="suggestion">💡 { data.Suggestion }</div>
	}
}

templ cloneGroupFull(data CloneGroupView) {
	<div class="clone-group" data-category={ string(data.Category) } data-priority={ string(data.Priority) } data-test={ strconv.FormatBool(data.HasTest) }>
		@cloneHeader(data)
		<div class="clone-body">
			@suggestionBlock(data)
			for i, cl := range data.Clones {
				@cloneOccurrence(cl, data.GroupNum, i)
			}
		</div>
	</div>
}

templ cloneGroupDiffFull(data CloneGroupView, diffData DiffView) {
	<div class="clone-group" data-category={ string(data.Category) } data-priority={ string(data.Priority) } data-test={ strconv.FormatBool(data.HasTest) }>
		@cloneHeader(data)
		<div class="clone-body">
			@suggestionBlock(data)
			if len(diffData.Others) == 0 {
				for i, cl := range data.Clones {
					@cloneOccurrence(cl, data.GroupNum, i)
				}
			} else {
				@diffViewContent(diffData)
			}
		</div>
	</div>
}

templ cloneOccurrence(cl CloneOccurrenceView, groupNum int, index int) {
	<div class="occurrence">
		<div class="file-link">
			<a href={ cl.VSCodeLink } title="Open in VSCode">
				@fileLineText(cl.Filename, cl.LineStart)
			</a>
			<button class="copy-btn" onclick={ copyCodeScript("code-" + strconv.Itoa(groupNum) + "-" + strconv.Itoa(index)) }>📋 Copy</button>
		</div>
		<pre><code id={ "code-" + strconv.Itoa(groupNum) + "-" + strconv.Itoa(index) }>{ cl.Fragment }</code></pre>
	</div>
}

templ diffStatBadge(cssClass string, value int, label string) {
	if value > 0 {
		<span class={ cssClass }>{ diffStatPrefix(cssClass) }{ strconv.Itoa(value) }{ label }</span>
	}
}

// diffStatAggregateItem renders a single stat badge for the aggregate-stats block.
templ diffStatAggregateItem(stats DiffAggregateStats, t string) {
	@diffStatBadge(t, diffStatValue(t, stats), " "+t)
}

// diffStatLegendItem renders a single stat label for the legend block.
templ diffStatLegendItem(t string) {
	@diffLegendItem(t, diffStatLabel(t))
}

// renderStatBlock wraps the for-each-diffStatTypes loop in a div with the
// given CSS class. Centralizes the for-loop and wrapping div that were
// previously duplicated across aggregate-stats and legend blocks.
templ renderStatBlock(wrapperClass string, makeItem func(t string) templ.Component) {
	<div class={ wrapperClass }>
		for _, t := range diffStatTypes {
			@makeItem(t)
		}
	</div>
}

templ fileAnchor(url templ.SafeURL, filename string, lineStart int) {
	<a href={ url }>
		@fileLineText(filename, lineStart)
	</a>
}

// fileLineText renders "filename:line" as plain text content.
// Centralizes the { filename }:{ strconv.Itoa(line) } pattern shared by
// fileAnchor and the diff selector's option dropdown.
templ fileLineText(filename string, line int) {
	//art-dupl:accept two expressions on one templ line ("filename:line"), not duplication
	{ filename }:{ strconv.Itoa(line) }
}

// fileInfoSpan renders a file-info wrapper around a fileAnchor.
// Centralizes the <span class="file-info">@fileAnchor(...)</span> markup used
// in both diff-base-header and diff-header contexts (CSS rules are identical).
templ fileInfoSpan(filename string, lineStart int) {
	<span class="file-info">
		@fileAnchor(safeVSCodeURL(filename, lineStart), filename, lineStart)
	</span>
}

templ diffLegendItem(cssClass string, label string) {
	<div class="diff-legend-item"><div class={ "diff-legend-color " + cssClass }></div>{ label }</div>
}

templ diffViewContent(data DiffView) {
	<div class="diff-mode">
		<div class="diff-base-header">
			<span class="label">📋 BASE REFERENCE</span>
			@fileInfoSpan(data.Base.Filename, data.Base.LineStart)
		</div>
		if data.AggregateStats.HasStats {
			@renderStatBlock("diff-aggregate-stats", func(t string) templ.Component { return diffStatAggregateItem(data.AggregateStats, t) })
		}
		@diffViewToggle(data.GroupNum)
		if len(data.Others) > 1 {
			@diffSelectorTempl(data)
		}
		for i, other := range data.Others {
			@diffComparison(data.GroupNum, other, i, len(data.Others))
		}
		@renderStatBlock("diff-legend", func(t string) templ.Component { return diffStatLegendItem(t) })
	</div>
}

templ diffComparison(groupNum int, other CloneDiff, index int, total int) {
	<div class={ templ.KV("diff-comparison", true), templ.KV("active", total == 1 || index == 0) } id={ "diff-compare-" + strconv.Itoa(groupNum) + "-" + strconv.Itoa(index) }>
		<div class="diff-header">
			@fileInfoSpan(other.Filename, other.LineStart)
			<span class="diff-stats">
				{{ added, removed, modified := countDiffStats(other.Diff) }}
				for _, t := range diffStatTypes {
					@diffStatBadge(t, diffStatValue(t, DiffAggregateStats{TotalAdded: added, TotalRemoved: removed, TotalModified: modified}), "")
				}
			</span>
		</div>
		<div class="diff-content" data-diff-index={ strconv.Itoa(index) }>
			@diffPanelsWithWordDiff(other)
		</div>
	</div>
}

templ diffPanel(panelClass string, title string, lines []DiffLine, oppositeLines []DiffLine, isBasePanel bool) {
	<div class={ "diff-panel " + panelClass }>
		<div class="diff-panel-title">{ title }</div>
		<pre>
			<code>
				@renderDiffLinesTempl(lines, oppositeLines, isBasePanel)
			</code>
		</pre>
	</div>
}

templ diffPanelsWithWordDiff(other CloneDiff) {
	@diffPanel("base", "Base Reference", other.Diff.Base, other.Diff.Compared, true)
	@diffPanel("compared", "Compared", other.Diff.Compared, other.Diff.Base, false)
}

templ diffViewToggleButton(groupNum int, mode string, label string, active bool) {
	<button id={ "diff-toggle-" + strconv.Itoa(groupNum) + "-" + mode } class={ templ.KV("active", active) } data-mode={ mode } onclick={ toggleDiffViewScript(groupNum, mode) }>{ label }</button>
}

templ diffViewToggle(groupNum int) {
	<div class="diff-view-toggle">
		@diffViewToggleButton(groupNum, "side", "◫ Side by Side", true)
		@diffViewToggleButton(groupNum, "inline", "▣ Inline", false)
	</div>
}

templ diffSelectorTempl(data DiffView) {
	<div class="diff-selector">
		<select id={ "diff-select-" + strconv.Itoa(data.GroupNum) } onchange={ showDiffScript("this.value", data.GroupNum) }>
			<option value="" disabled selected>Compare with...</option>
			for i, other := range data.Others {
				<option value={ strconv.Itoa(i) }>
					@fileLineText(other.Filename, other.LineStart)
				</option>
			}
		</select>
	</div>
}

templ renderDiffLinesTempl(lines []DiffLine, oppositeLines []DiffLine, isBasePanel bool) {
	for i, line := range lines {
		{{
			typeClass := diffLineTypeClass(line.Type)
			content := diffLineContent(line, i, oppositeLines, isBasePanel)
		}}
		<div class={ "diff-line " + typeClass }>
			<span class="diff-line-num">{ strconv.Itoa(line.LineNumber) }</span>
			<span class="diff-line-content">
				@templ.Raw(content)
			</span>
		</div>
	}
}
